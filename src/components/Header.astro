---
import { WHATSAPP_URL } from "../constants";
import Icon from "../components/Icon.astro";
---

<header
  id="main-header"
  class="fixed top-0 left-0 w-full h-header-mobile md:h-header z-50 flex items-center transition-all duration-[0.6s] ease-out"
>
  <div class="container max-w-container mx-auto px-6 flex justify-between items-center w-full">
    <a href="/" class="font-heading text-[1.4rem] no-underline text-inherit transition-transform duration-300 flex items-center gap-2.5">
      <img src="/assets/logo.webp" alt="Glow Studio Icon" width="28" height="28" class="w-7 h-7 object-contain rounded-full border border-glow-gold/15 transition-opacity duration-300" />
      <span>GLOW STUDIO</span>
    </a>

    <!-- Hamburger + label (mobile only) -->
    <div class="flex items-center gap-3 md:hidden">
      <span id="menu-label" class="text-[0.7rem] font-mono tracking-[0.2em] text-glow-gold/70 transition-opacity duration-300 opacity-0">MENU</span>
      <button class="hamburger flex flex-col justify-center items-center w-10 h-10 bg-none border-none p-2 cursor-pointer relative" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav">
        <span class="block w-6 h-[1.5px] bg-glow-charcoal rounded transition-all duration-[0.4s] ease-out"></span>
        <span class="block w-6 h-[1.5px] bg-glow-charcoal rounded mt-[6px] transition-all duration-[0.4s] ease-out"></span>
        <span class="block w-6 h-[1.5px] bg-glow-charcoal rounded mt-[6px] transition-all duration-[0.4s] ease-out"></span>
      </button>
    </div>

    <!-- Desktop nav + mobile panel -->
    <div id="mobile-nav" class="nav-wrapper flex items-center gap-8 max-md:fixed max-md:top-0 max-md:right-0 max-md:w-[85vw] max-md:max-w-[360px] max-md:h-dvh max-md:flex-col max-md:items-stretch max-md:gap-0 max-md:bg-glow-cream max-md:pt-[calc(var(--header-height-mobile,70px)+2rem)] max-md:px-8 max-md:pb-8 max-md:z-60 max-md:translate-x-full max-md:transition-transform max-md:duration-500 max-md:ease-out max-md:shadow-[-10px_0_40px_rgba(0,0,0,0.08)] max-md:overflow-y-auto">
      <!-- Close button (mobile only) -->
      <button class="nav-close hidden max-md:flex absolute top-[14px] right-5 w-8 h-8 items-center justify-center rounded-full border border-glow-gold/50 text-glow-gold text-lg hover:bg-glow-gold/10 hover:border-glow-gold transition-colors" aria-label="Cerrar menú">&times;</button>
      <nav>
        <ul class="flex gap-8 list-none max-md:flex-col max-md:gap-0 items-center max-md:items-stretch">
          <!-- Inicio with dropdown (desktop) / accordion-indent (mobile) -->
          <li class="relative group/dropdown py-2 max-md:py-0">
            <span class="cursor-pointer nav-link text-glow-charcoal no-underline text-[0.87rem] font-light opacity-60 hover:opacity-100 transition-opacity flex items-center gap-1 max-md:hidden">
              Inicio <Icon name="chevron-down" size={12} class="text-glow-gold/80 transition-transform duration-300 group-hover/dropdown:rotate-180" />
            </span>
            <div class="hidden max-md:block">
              <a href="/" class="nav-link text-glow-charcoal no-underline text-[1.1rem] font-medium border-b border-glow-gold/10 py-3 block">
                Inicio
              </a>
              <ul class="list-none pl-4 flex flex-col gap-0 border-l border-glow-gold/10 ml-2 mt-1">
                <li><a href="/#filosofia" class="nav-link text-glow-charcoal/70 no-underline text-[0.92rem] font-light py-2 block">Filosofía</a></li>
                <li><a href="/#rituales" class="nav-link text-glow-charcoal/70 no-underline text-[0.92rem] font-light py-2 block">Experiencias</a></li>
                <li><a href="/#metodo" class="nav-link text-glow-charcoal/70 no-underline text-[0.92rem] font-light py-2 block">El Método</a></li>
                <li><a href="/#contacto" class="nav-link text-glow-charcoal/70 no-underline text-[0.92rem] font-light py-2 block">Reservas</a></li>
              </ul>
            </div>
            
            <!-- Dropdown Menu (Desktop only) -->
            <ul class="absolute left-1/2 -translate-x-1/2 top-full mt-2 w-48 bg-glow-cream/95 backdrop-blur-md border border-glow-gold/15 rounded-md py-3 shadow-[0_15px_30px_rgba(0,0,0,0.06)] list-none opacity-0 invisible translate-y-2 transition-all duration-300 group-hover/dropdown:opacity-100 group-hover/dropdown:visible group-hover/dropdown:translate-y-0 z-70 flex flex-col gap-1.5 max-md:hidden">
              <li><a href="/" class="block px-6 py-2 text-[0.82rem] text-glow-charcoal/80 hover:text-glow-gold hover:bg-glow-gold/5 transition-all">Portada</a></li>
              <li><a href="/#filosofia" class="block px-6 py-2 text-[0.82rem] text-glow-charcoal/80 hover:text-glow-gold hover:bg-glow-gold/5 transition-all">Filosofía</a></li>
              <li><a href="/#rituales" class="block px-6 py-2 text-[0.82rem] text-glow-charcoal/80 hover:text-glow-gold hover:bg-glow-gold/5 transition-all">Experiencias</a></li>
              <li><a href="/#metodo" class="block px-6 py-2 text-[0.82rem] text-glow-charcoal/80 hover:text-glow-gold hover:bg-glow-gold/5 transition-all">El Método</a></li>
              <li><a href="/#contacto" class="block px-6 py-2 text-[0.82rem] text-glow-charcoal/80 hover:text-glow-gold hover:bg-glow-gold/5 transition-all">Reservas</a></li>
            </ul>
          </li>
          <li><a href="/rituales" class="nav-link text-glow-charcoal no-underline text-[0.87rem] font-light opacity-60 hover:opacity-100 transition-opacity relative max-md:block max-md:py-4 max-md:text-[1.1rem] max-md:opacity-100 max-md:border-b max-md:border-glow-gold/10">Rituales</a></li>
          <li><a href="/nosotros" class="nav-link text-glow-charcoal no-underline text-[0.87rem] font-light opacity-60 hover:opacity-100 transition-opacity relative max-md:block max-md:py-4 max-md:text-[1.1rem] max-md:opacity-100 max-md:border-b max-md:border-glow-gold/10">Nosotros</a></li>
          <li><a href="/metodo" class="nav-link text-glow-charcoal no-underline text-[0.87rem] font-light opacity-60 hover:opacity-100 transition-opacity relative max-md:block max-md:py-4 max-md:text-[1.1rem] max-md:opacity-100 max-md:border-b max-md:border-glow-gold/10">Método</a></li>
          <li><a href="/contacto" class="nav-link text-glow-charcoal no-underline text-[0.87rem] font-light opacity-60 hover:opacity-100 transition-opacity relative max-md:block max-md:py-4 max-md:text-[1.1rem] max-md:opacity-100 max-md:border-b max-md:border-glow-gold/10">Contacto</a></li>
        </ul>
      </nav>
      <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="nav-cta btn-glow btn-glow-sm max-md:block max-md:text-center max-md:mt-6 max-md:py-4 max-md:text-base max-md:w-full">
        Tu ritual <span class="max-md:hidden btn-arrow">→</span>
      </a>
    </div>
  </div>

</header>

<style>
  header.scrolled {
    background: rgba(244, 238, 228, 0.85);
    backdrop-filter: blur(30px);
    height: 60px;
    border-bottom: 1px solid rgba(168, 132, 90, 0.1);
  }

  @media (min-width: 768px) {
    header.scrolled {
      height: 80px;
    }
  }

  header.menu-open {
    background: transparent;
    backdrop-filter: none;
    border-bottom: none;
    height: var(--header-height-mobile, 70px);
  }

  @media (min-width: 768px) {
    header.menu-open {
      height: var(--header-height, 100px);
    }
  }

  header.menu-open .font-heading {
    color: rgba(255, 255, 255, 0.45);
  }

  header.menu-open .font-heading img {
    opacity: 0.7;
    pointer-events: none;
  }

  header.menu-open .hamburger span {
    background: rgba(255, 255, 255, 0.55);
  }

  header.menu-open .nav-wrapper {
    transform: translateX(0);
  }

  /* Hamburger to X animation */
  .hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  header.menu-open #menu-label {
    opacity: 1;
  }

  /* Nav link underline on hover */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: #A8845A;
    transition: width 0.3s;
  }

  .nav-link:hover::after {
    width: 100%;
  }
</style>

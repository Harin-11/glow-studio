---
// Header component
---

<header
  id="main-header"
  class="fixed top-0 left-0 w-full h-header-mobile md:h-header z-50 flex items-center transition-all duration-[0.6s] ease-out"
>
  <div class="container max-w-container mx-auto px-6 flex justify-between items-center w-full">
    <a href="#" class="font-heading text-[1.5rem] no-underline text-inherit transition-transform duration-300">
      GLOW STUDIO
    </a>

    <!-- Hamburger + label (mobile only) -->
    <div class="flex items-center gap-3 md:hidden">
      <span id="menu-label" class="text-[0.7rem] font-mono tracking-[0.2em] text-glow-gold/70 transition-opacity duration-300 opacity-0">MENU</span>
      <button class="hamburger flex flex-col justify-center items-center w-10 h-10 bg-none border-none p-2 cursor-pointer relative" aria-label="Abrir menú" aria-expanded="false">
        <span class="block w-6 h-[1.5px] bg-glow-charcoal rounded transition-all duration-[0.4s] ease-out"></span>
        <span class="block w-6 h-[1.5px] bg-glow-charcoal rounded mt-[6px] transition-all duration-[0.4s] ease-out"></span>
        <span class="block w-6 h-[1.5px] bg-glow-charcoal rounded mt-[6px] transition-all duration-[0.4s] ease-out"></span>
      </button>
    </div>

    <!-- Desktop nav + mobile panel -->
    <div class="nav-wrapper flex items-center gap-8 max-md:fixed max-md:top-0 max-md:right-0 max-md:w-[85vw] max-md:max-w-[360px] max-md:h-dvh max-md:flex-col max-md:items-stretch max-md:gap-0 max-md:bg-glow-cream max-md:pt-[calc(var(--header-height-mobile,70px)+2rem)] max-md:px-8 max-md:pb-8 max-md:z-60 max-md:translate-x-full max-md:transition-transform max-md:duration-500 max-md:ease-out max-md:shadow-[-10px_0_40px_rgba(0,0,0,0.08)]">
      <!-- Close button (mobile only) -->
      <button class="nav-close hidden max-md:flex absolute top-[14px] right-5 w-8 h-8 items-center justify-center rounded-full border border-glow-gold/50 text-glow-gold text-lg hover:bg-glow-gold/10 hover:border-glow-gold transition-colors" aria-label="Cerrar menú">&times;</button>
      <nav>
        <ul class="flex gap-8 list-none max-md:flex-col max-md:gap-0">
          <li><a href="#rituales" class="nav-link text-glow-charcoal no-underline text-[0.87rem] font-light opacity-60 hover:opacity-100 transition-opacity relative max-md:block max-md:py-4 max-md:text-[1.1rem] max-md:opacity-100 max-md:border-b max-md:border-glow-gold/10">Rituales</a></li>
          <li><a href="#filosofia" class="nav-link text-glow-charcoal no-underline text-[0.87rem] font-light opacity-60 hover:opacity-100 transition-opacity relative max-md:block max-md:py-4 max-md:text-[1.1rem] max-md:opacity-100 max-md:border-b max-md:border-glow-gold/10">Nosotros</a></li>
          <li><a href="#metodo" class="nav-link text-glow-charcoal no-underline text-[0.87rem] font-light opacity-60 hover:opacity-100 transition-opacity relative max-md:block max-md:py-4 max-md:text-[1.1rem] max-md:opacity-100 max-md:border-b max-md:border-glow-gold/10">Método</a></li>
          <li><a href="#equipo" class="nav-link text-glow-charcoal no-underline text-[0.87rem] font-light opacity-60 hover:opacity-100 transition-opacity relative max-md:block max-md:py-4 max-md:text-[1.1rem] max-md:opacity-100 max-md:border-b max-md:border-glow-gold/10">Equipo</a></li>
          <li><a href="#contacto" class="nav-link text-glow-charcoal no-underline text-[0.87rem] font-light opacity-60 hover:opacity-100 transition-opacity relative max-md:block max-md:py-4 max-md:text-[1.1rem] max-md:opacity-100 max-md:border-b max-md:border-glow-gold/10">Contacto</a></li>
        </ul>
      </nav>
      <a href="https://wa.me/yournumber" class="nav-cta group inline-flex items-center gap-2 bg-glow-gold text-white px-6 py-3 no-underline text-[0.87rem] font-medium rounded-full transition-all duration-300 hover:bg-glow-gold-light hover:shadow-[0_6px_24px_-4px_rgba(168,132,90,0.3)] hover:-translate-y-0.5 active:scale-95 active:shadow-none max-md:block max-md:text-center max-md:mt-6 max-md:py-4 max-md:text-base">
        Tu ritual <span class="max-md:hidden">→</span>
      </a>
    </div>
  </div>

  <!-- Overlay: covers page content below header, blur effect -->
</header>

<style>
  header.scrolled {
    background: rgba(244, 238, 228, 0.85);
    backdrop-filter: blur(30px);
    height: 60px;
    border-bottom: 1px solid rgba(168, 132, 90, 0.1);
  }

  @media (min-width: 768px) {
    header.scrolled {
      height: 80px;
    }
  }

  header.menu-open {
    background: transparent;
    backdrop-filter: none;
    border-bottom: none;
    height: var(--header-height-mobile, 70px);
  }

  @media (min-width: 768px) {
    header.menu-open {
      height: var(--header-height, 100px);
    }
  }

  header.menu-open .font-heading {
    color: transparent;
  }


  header.menu-open .hamburger span {
    background: rgba(255, 255, 255, 0.30);
  }

  header.menu-open .nav-wrapper {
    transform: translateX(0);
  }

  /* Hamburger to X animation */
  .hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  header.menu-open #menu-label {
    opacity: 1;
  }

  /* Nav link underline on hover */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: #A8845A;
    transition: width 0.3s;
  }

  .nav-link:hover::after {
    width: 100%;
  }
</style>

---
// Footer — redes sociales con iconos animados
---

<footer class="bg-glow-charcoal text-white py-12 md:py-16 lg:py-20 pb-8 border-t border-white/5">
  <div class="container max-w-container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12 mb-12">
      <div class="md:col-span-2 lg:col-span-1">
        <a href="#" class="font-heading text-[1.5rem] text-white no-underline">GLOW STUDIO</a>
        <p class="text-white/50 mt-6 max-w-[300px] font-body font-light text-[0.9rem] leading-relaxed">
          Diseñando momentos de bienestar y cuidado consciente en Arequipa.
        </p>
      </div>
      <div>
        <div class="label text-white mb-4">Navegación</div>
        <ul class="list-none flex flex-col gap-3">
          <li><a href="#" class="text-white/60 no-underline text-[0.9rem] font-light hover:text-white transition-colors">Rituales</a></li>
          <li><a href="#" class="text-white/60 no-underline text-[0.9rem] font-light hover:text-white transition-colors">Nosotros</a></li>
          <li><a href="#" class="text-white/60 no-underline text-[0.9rem] font-light hover:text-white transition-colors">Equipo</a></li>
        </ul>
      </div>
      <div>
        <div class="label text-white mb-4">Legal</div>
        <ul class="list-none flex flex-col gap-3">
          <li><a href="#" class="text-white/60 no-underline text-[0.9rem] font-light hover:text-white transition-colors">Privacidad</a></li>
          <li><a href="#" class="text-white/60 no-underline text-[0.9rem] font-light hover:text-white transition-colors">Términos</a></li>
        </ul>
      </div>
      <div>
        <div class="label text-white mb-4">Social</div>
        <ul class="list-none flex flex-col gap-4">
          <!-- Instagram -->
          <li>
            <a href="#" class="group inline-flex items-center gap-3 text-white/50 no-underline text-[0.9rem] font-light hover:text-white transition-all duration-300">
              <span class="w-5 h-5 flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-hover:-translate-y-0.5">
                <svg class="w-5 h-5 transition-colors duration-300 group-hover:text-[#E4405F]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </span>
              <span class="transition-all duration-300 group-hover:translate-x-0.5">Instagram</span>
            </a>
          </li>
          <!-- Facebook -->
          <li>
            <a href="#" class="group inline-flex items-center gap-3 text-white/50 no-underline text-[0.9rem] font-light hover:text-white transition-all duration-300">
              <span class="w-5 h-5 flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-hover:-translate-y-0.5">
                <svg class="w-5 h-5 transition-colors duration-300 group-hover:text-[#1877F2]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </span>
              <span class="transition-all duration-300 group-hover:translate-x-0.5">Facebook</span>
            </a>
          </li>
          <!-- TikTok -->
          <li>
            <a href="#" class="group inline-flex items-center gap-3 text-white/50 no-underline text-[0.9rem] font-light hover:text-white transition-all duration-300">
              <span class="w-5 h-5 flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-hover:-translate-y-0.5">
                <svg class="w-5 h-5 transition-colors duration-300 group-hover:text-[#00f2ea]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
              </span>
              <span class="transition-all duration-300 group-hover:translate-x-0.5">TikTok</span>
            </a>
          </li>
          <!-- WhatsApp -->
          <li>
            <a href="#" class="group inline-flex items-center gap-3 text-white/50 no-underline text-[0.9rem] font-light hover:text-white transition-all duration-300">
              <span class="w-5 h-5 flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-hover:-translate-y-0.5">
                <svg class="w-5 h-5 transition-colors duration-300 group-hover:text-[#25D366]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              </span>
              <span class="transition-all duration-300 group-hover:translate-x-0.5">WhatsApp</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="pt-6 border-t border-white/5 text-center text-white/30 text-[11px] font-light">
      © 2026 Glow Studio · Arequipa · Diseñado con intención
    </div>
  </div>
</footer>

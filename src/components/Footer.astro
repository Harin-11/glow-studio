---
import { WHATSAPP_URL, SOCIAL } from "../constants";
import Icon from "../components/Icon.astro";
---

<footer class="bg-glow-charcoal text-white py-12 md:py-16 lg:py-20 pb-8 border-t border-white/5">
  <div class="container max-w-container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12 mb-12">
      <div class="md:col-span-2 lg:col-span-1">
        <a href="/" class="font-heading text-[1.4rem] text-white no-underline flex items-center gap-2.5">
          <img src="/assets/logo.webp" alt="Glow Studio Icon" class="w-7 h-7 object-contain rounded-full border border-glow-gold/20 bg-white/5" />
          <span>GLOW STUDIO</span>
        </a>
        <p class="text-white/50 mt-6 max-w-[300px] font-body font-light text-[0.9rem] leading-relaxed">
          Diseñando momentos de bienestar y cuidado consciente en Arequipa.
        </p>
      </div>
      <div>
        <div class="label text-white mb-4">Navegación</div>
        <ul class="list-none flex flex-col gap-3">
          <li><a href="/rituales" class="text-white/60 no-underline text-[0.9rem] font-light hover:text-white transition-colors">Rituales</a></li>
          <li><a href="/nosotros" class="text-white/60 no-underline text-[0.9rem] font-light hover:text-white transition-colors">Nosotros</a></li>
          <li><a href="/metodo" class="text-white/60 no-underline text-[0.9rem] font-light hover:text-white transition-colors">Método</a></li>
          <li><a href="/contacto" class="text-white/60 no-underline text-[0.9rem] font-light hover:text-white transition-colors">Contacto</a></li>
        </ul>
      </div>
      <div>
        <div class="label text-white mb-4">Legal</div>
        <ul class="list-none flex flex-col gap-3">
          <li><a href="/privacidad" class="text-white/60 no-underline text-[0.9rem] font-light hover:text-white transition-colors">Privacidad</a></li>
          <li><a href="/terminos" class="text-white/60 no-underline text-[0.9rem] font-light hover:text-white transition-colors">Términos</a></li>
        </ul>
      </div>
      <div>
        <div class="label text-white mb-4">Social</div>
        <ul class="list-none flex flex-col gap-4">
          <!-- Instagram -->
          <li>
            <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-3 text-white/50 no-underline text-[0.9rem] font-light hover:text-white transition-all duration-300">
              <span class="w-5 h-5 flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-hover:-translate-y-0.5">
                <Icon name="instagram" size={20} class="transition-colors duration-300 group-hover:text-[#E4405F]" />
              </span>
              <span class="transition-all duration-300 group-hover:translate-x-0.5">Instagram</span>
            </a>
          </li>
          <!-- Facebook -->
          <li>
            <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-3 text-white/50 no-underline text-[0.9rem] font-light hover:text-white transition-all duration-300">
              <span class="w-5 h-5 flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-hover:-translate-y-0.5">
                <Icon name="facebook" size={20} strokeWidth={1.5} class="transition-colors duration-300 group-hover:text-[#1877F2]" />
              </span>
              <span class="transition-all duration-300 group-hover:translate-x-0.5">Facebook</span>
            </a>
          </li>
          <!-- TikTok -->
          <li>
            <a href={SOCIAL.tiktok} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-3 text-white/50 no-underline text-[0.9rem] font-light hover:text-white transition-all duration-300">
              <span class="w-5 h-5 flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-hover:-translate-y-0.5">
                <Icon name="tiktok" size={20} strokeWidth={1.5} class="transition-colors duration-300 group-hover:text-[#00f2ea]" />
              </span>
              <span class="transition-all duration-300 group-hover:translate-x-0.5">TikTok</span>
            </a>
          </li>
          <!-- WhatsApp -->
          <li>
            <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-3 text-white/50 no-underline text-[0.9rem] font-light hover:text-white transition-all duration-300">
              <span class="w-5 h-5 flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-hover:-translate-y-0.5">
                <Icon name="whatsapp" size={20} strokeWidth={1.5} class="transition-colors duration-300 group-hover:text-[#25D366]" />
              </span>
              <span class="transition-all duration-300 group-hover:translate-x-0.5">WhatsApp</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="pt-6 border-t border-white/5 text-center text-white/60 text-[11px] font-light">
      © 2026 Glow Studio · Arequipa · Diseñado con intención
    </div>
  </div>
</footer>

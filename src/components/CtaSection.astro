---
import { WHATSAPP_URL, SOCIAL } from "../constants";
import Icon from "../components/Icon.astro";
---

<section id="contacto" class="bg-glow-charcoal text-white text-center py-12 md:py-16 lg:py-20">
  <div class="container max-w-container mx-auto px-6 reveal">
    <div class="label text-glow-gold mb-6 md:mb-8">Tu primer ritual te espera.</div>
    <h2 class="font-display italic font-light text-4xl md:text-5xl lg:text-6xl leading-[1.05] text-white mb-6 md:mb-8 lg:mb-12">&ldquo;Reserva tu momento.&rdquo;</h2>
    <p class="text-white/60 font-body font-light mb-8 md:mb-12">Sin formularios. Sin esperas. Solo escríbenos.</p>
    <div class="cta-buttons flex flex-col md:flex-row items-center justify-center gap-4">
      <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="btn-glow btn-glow-lg w-full md:w-auto max-w-[280px] md:max-w-none text-center justify-center">
        <Icon name="whatsapp" size={16} />
        WhatsApp
      </a>
      <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" class="btn-outline btn-glow-lg w-full md:w-auto max-w-[280px] md:max-w-none text-center justify-center">
        <Icon name="instagram" size={16} />
        Instagram
      </a>
    </div>
  </div>
</section>
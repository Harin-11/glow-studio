---
// Hero Section — balanced typography + mobile spacing
---

<section id="home" class="hero min-h-[85vh] md:min-h-screen pt-header-mobile md:pt-header flex items-center overflow-hidden relative">
  <span class="section-num absolute font-display text-[120px] text-glow-gold/5 left-0 top-[20%] pointer-events-none max-md:text-[80px] max-md:top-[5%]">01</span>
  <div class="container max-w-container mx-auto px-6 grid grid-cols-1 md:grid-cols-2 h-full relative">
    <div class="hero-content z-10 pt-8 md:pt-12 lg:pt-16">
      <div class="label reveal mb-4 md:mb-8 text-glow-dusk">Glow Studio · Arequipa</div>
      <!-- Balanced size: between original huge and QA reduction -->
      <h1 class="display-text font-display font-light text-[clamp(2.3rem,6vw,3.5rem)] md:text-[clamp(3.5rem,6vw,6rem)] leading-[1.1] -tracking-[0.02em] mb-3 md:mb-6 reveal">
        Donde la piel<br />vuelve a<br />respirar.
      </h1>
      <p class="font-display italic text-[1.1rem] md:text-[1.4rem] mb-5 md:mb-10 text-glow-bark reveal">
        Tratamientos pensados para ti. Resultados que se sienten.
      </p>
      <a href="#rituales" class="nav-cta group inline-flex items-center gap-2 bg-glow-gold text-white px-6 py-3 no-underline text-[0.87rem] transition-all duration-300 hover:bg-glow-gold-light active:scale-95 reveal">
        Conoce tus rituales
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Hero image: shown below content on mobile, side-by-side on desktop -->
    <div class="hero-visual relative w-full mt-6 md:mt-0 md:h-full md:block">
      <img
        src="/assets/hero.webp"
        alt="Ambiente Glow Studio"
        class="w-full h-auto md:absolute md:right-[-2%] md:top-[5%] md:w-[105%] md:h-[90%] object-cover z-[3] md:shadow-[0_40px_100px_-20px_rgba(0,0,0,0.1)] md:[clip-path:polygon(15%_0%,100%_0%,100%_100%,0%_100%)] max-md:aspect-[16/10] max-md:object-cover max-md:rounded-sm"
      />
    </div>
  </div>
  <div class="scroll-indicator absolute bottom-10 left-1/2 -translate-x-1/2 max-md:hidden">
    <div class="label opacity-50 text-[9px] text-center">Scroll</div>
    <div class="w-[1px] h-10 bg-glow-gold/30 mx-auto mt-2.5"></div>
  </div>
</section>

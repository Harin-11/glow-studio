---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { WHATSAPP_MESSAGE } from "../constants";

const categories = [
  { id: "todos", name: "Todos" },
  { id: "rostro", name: "Rostro" },
  { id: "mirada", name: "Mirada" },
  { id: "manos", name: "Manos" },
  { id: "cuerpo", name: "Cuerpo" }
];

const ritualesList = [
  {
    id: "facial-profundo",
    name: "Ritual Facial Profundo",
    category: "rostro",
    categoryLabel: "Rostro",
    duration: "75 min",
    price: "S/. 150",
    img: "/assets/facial.webp",
    desc: "Limpieza profunda con vapor de ozono, exfoliación ultrasónica, extracción manual minuciosa, mascarilla de arcilla rosa descongestiva y masaje facial relajante."
  },
  {
    id: "glow-instantaneo",
    name: "Ritual Glow Instantáneo",
    category: "rostro",
    categoryLabel: "Rostro",
    duration: "50 min",
    price: "S/. 120",
    img: "/assets/hero.webp",
    desc: "Tratamiento hidratante exprés diseñado para devolver la luminosidad y vitalidad antes de un evento. Incluye velo de colágeno y masaje drenante con esferas frías."
  },
  {
    id: "lifting-sin-agujas",
    name: "Lifting Facial Sin Agujas",
    category: "rostro",
    categoryLabel: "Rostro",
    duration: "90 min",
    price: "S/. 220",
    img: "/assets/facial.webp",
    desc: "Protocolo rejuvenecedor avanzado mediante radiofrecuencia tripolar y masaje esculpido manual. Estimula la producción de colágeno y redefine el óvalo facial."
  },
  {
    id: "escultura-cejas",
    name: "Escultura & Diseño de Cejas",
    category: "mirada",
    categoryLabel: "Mirada",
    duration: "45 min",
    price: "S/. 60",
    img: "/assets/eyebrows.webp",
    desc: "Visagismo personalizado, depilación con cera orgánica de baja temperatura, perfilado de precisión y sombreado temporal con henna natural."
  },
  {
    id: "lifting-pestanas",
    name: "Lifting de Pestañas Premium",
    category: "mirada",
    categoryLabel: "Mirada",
    duration: "60 min",
    price: "S/. 110",
    img: "/assets/eyebrows.webp",
    desc: "Curvatura y teñido de pestañas naturales usando fórmulas nutritivas ricas en queratina y pantenol. Resultados visibles de 6 a 8 semanas."
  },
  {
    id: "manicure-atelier",
    name: "Manicure Atelier",
    category: "manos",
    categoryLabel: "Manos",
    duration: "50 min",
    price: "S/. 75",
    img: "/assets/manicure.webp",
    desc: "Manicura rusa de precisión combinada con esmaltado semipermanente de alta calidad. Incluye exfoliación suave y masaje hidratante de manos."
  },
  {
    id: "pedicure-spa",
    name: "Pedicure Spa Orgánica",
    category: "manos",
    categoryLabel: "Manos",
    duration: "75 min",
    price: "S/. 110",
    img: "/assets/manicure.webp",
    desc: "Cuidado profundo de pies con sales aromáticas, remoción de asperezas, exfoliación de coco, mascarilla nutritiva y masaje relajante."
  },
  {
    id: "masaje-relajante",
    name: "Masaje Relajante Aromaterapia",
    category: "cuerpo",
    categoryLabel: "Cuerpo",
    duration: "60 min",
    price: "S/. 130",
    img: "/assets/massage.webp",
    desc: "Terapia corporal completa con aceites esenciales de lavanda y manzanilla. Diseñado para disolver la tensión muscular y calmar el sistema nervioso."
  },
  {
    id: "detox-corporal",
    name: "Ritual Detox Corporal",
    category: "cuerpo",
    categoryLabel: "Cuerpo",
    duration: "90 min",
    price: "S/. 190",
    img: "/assets/massage.webp",
    desc: "Exfoliación con sales marinas, envoltura de lodos termales desintoxicantes y masaje de drenaje linfático corporal suave."
  }
];
---

<Layout title="Rituales & Experiencias — Glow Studio" description="Explora nuestro catálogo de tratamientos faciales, diseño de cejas y pestañas, manicura atelier y masajes relajantes en Arequipa. Reserva tu momento de cuidado consciente.">
  <Header />

  <main id="main-content" class="pt-header-mobile md:pt-header bg-glow-cream overflow-hidden">
    <!-- Hero Section -->
    <section class="relative py-16 md:py-24 lg:py-32">
      <span class="absolute font-display text-[120px] text-glow-gold/5 left-[5%] top-[10%] pointer-events-none max-md:text-[80px]">03</span>
      <div class="container max-w-container mx-auto px-6 text-center">
        <div class="label reveal mb-6 text-glow-dusk">Nuestro Catálogo</div>
        <h1 class="display-text font-display font-light text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.1] mb-6 reveal">
          Rituales <span class="italic">de cabina.</span>
        </h1>
        <p class="font-body font-light text-glow-bark max-w-2xl mx-auto reveal">
          Tratamientos diseñados a la medida de tu piel. Encuentra el espacio idóneo para reconectar con tu bienestar.
        </p>
      </div>
    </section>

    <!-- Filters & Catalog Section -->
    <section class="py-12 md:py-16 bg-glow-mist border-t border-glow-gold/10 min-h-[60vh]">
      <div class="container max-w-container mx-auto px-6">
        <!-- Filter Tabs -->
        <div class="flex flex-wrap justify-center gap-2 md:gap-4 mb-16 reveal">
          {categories.map((cat) => (
            <button
              class={`filter-tab px-6 py-2.5 rounded-full text-[0.82rem] font-mono tracking-wider uppercase border transition-all duration-300 ${
                cat.id === "todos"
                  ? "bg-glow-gold border-glow-gold text-white shadow-sm"
                  : "bg-transparent border-glow-gold/20 text-glow-bark hover:border-glow-gold/50"
              }`}
              data-filter={cat.id}
            >
              {cat.name}
            </button>
          ))}
        </div>

        <!-- Catalog Grid -->
        <div id="catalog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
          {ritualesList.map((rit) => (
            <div
              class="catalog-item reveal group bg-glow-cream rounded-sm border border-glow-gold/10 overflow-hidden shadow-sm flex flex-col transition-all duration-500"
              data-category={rit.category}
            >
              <div class="relative aspect-[16/10] bg-glow-parchment overflow-hidden">
                <img
                  src={rit.img}
                  alt={rit.name}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-103 grayscale-[5%]"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4 bg-glow-charcoal/80 backdrop-blur-sm px-3 py-1 rounded-full text-white text-[0.7rem] font-mono tracking-wider uppercase">
                  {rit.categoryLabel}
                </div>
              </div>
              <div class="p-6 md:p-8 flex flex-col flex-grow">
                <div class="flex justify-between items-start gap-4 mb-4">
                  <h3 class="font-heading font-medium text-xl text-glow-charcoal leading-tight">
                    {rit.name}
                  </h3>
                  <div class="text-right">
                    <div class="font-mono text-[0.8rem] text-glow-gold font-medium whitespace-nowrap">{rit.price}</div>
                    <div class="font-mono text-[0.65rem] text-glow-dusk mt-1">{rit.duration}</div>
                  </div>
                </div>
                <p class="font-body font-light text-[0.88rem] leading-relaxed text-glow-bark/85 mb-8 flex-grow">
                  {rit.desc}
                </p>
                <a
                  href={WHATSAPP_MESSAGE(`Hola Glow Studio, quisiera reservar el ${rit.name}.`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-glow btn-glow-sm w-full text-center justify-center py-3 text-[0.78rem]"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                  Reservar Ritual
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Care Protocol Banner -->
    <section class="py-16 md:py-20 lg:py-24 bg-glow-cream border-t border-glow-gold/10">
      <div class="container max-w-container mx-auto px-6 reveal">
        <div class="bg-glow-charcoal text-white rounded-sm p-8 md:p-12 lg:p-16 relative overflow-hidden">
          <div class="relative z-10 max-w-2xl">
            <div class="label text-glow-gold mb-4">Protocolo de Atención</div>
            <h2 class="font-heading font-medium text-2xl md:text-3xl mb-6">¿Cómo prepararte para tu ritual?</h2>
            <ul class="space-y-4 font-body font-light text-[0.9rem] text-white/70">
              <li class="flex gap-3 items-start">
                <span class="text-glow-gold font-mono">•</span>
                <span>Llega 10 minutos antes de tu cita para relajarte en nuestra sala de espera y tomar una infusión botánica de bienvenida.</span>
              </li>
              <li class="flex gap-3 items-start">
                <span class="text-glow-gold font-mono">•</span>
                <span>Te sugerimos venir con ropa cómoda y sin maquillaje si tu tratamiento es facial.</span>
              </li>
              <li class="flex gap-3 items-start">
                <span class="text-glow-gold font-mono">•</span>
                <span>Por favor infórmanos con anticipación si estás embarazada o tienes alergias dermatológicas activas.</span>
              </li>
            </ul>
          </div>
          <span class="absolute right-[2%] bottom-[-5%] font-display text-[100px] md:text-[130px] text-white/2 pointer-events-none select-none max-md:hidden">GLOW</span>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // Client-side filtering logic
  const tabs = document.querySelectorAll(".filter-tab");
  const items = document.querySelectorAll(".catalog-item");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      // Update active tab button style
      tabs.forEach((t) => {
        t.classList.remove("bg-glow-gold", "border-glow-gold", "text-white", "shadow-sm");
        t.classList.add("bg-transparent", "border-glow-gold/20", "text-glow-bark", "hover:border-glow-gold/50");
      });
      tab.classList.add("bg-glow-gold", "border-glow-gold", "text-white", "shadow-sm");
      tab.classList.remove("bg-transparent", "border-glow-gold/20", "text-glow-bark", "hover:border-glow-gold/50");

      const filter = tab.getAttribute("data-filter");

      items.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        const cat = item.getAttribute("data-category");

        if (filter === "todos" || cat === filter) {
          // Show item with transition
          item.style.display = "flex";
          setTimeout(() => {
            item.style.opacity = "1";
            item.style.transform = "scale(1) translateY(0)";
          }, 50);
        } else {
          // Hide item
          item.style.opacity = "0";
          item.style.transform = "scale(0.95) translateY(10px)";
          setTimeout(() => {
            item.style.display = "none";
          }, 300);
        }
      });
    });
  });
</script>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Contacto — Glow Studio"
    description="Ponte en contacto con Glow Studio en Arequipa. Agenda tu cita, consulta sobre nuestros rituales y resuelve tus dudas sobre el cuidado consciente de la piel."
>
    <Header />

    <main
        id="main-content"
        class="pt-header-mobile md:pt-header bg-glow-cream overflow-hidden"
    >
        <!-- Hero Section -->
        <section class="relative py-16 md:py-24">
            <span
                class="absolute font-display text-[120px] text-glow-gold/5 left-[5%] top-[10%] pointer-events-none max-md:text-[80px]"
                >05</span
            >
            <div class="container max-w-container mx-auto px-6 text-center">
                <div class="label reveal mb-6 text-glow-dusk">Contacto</div>
                <h1
                    class="display-text font-display font-light text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.1] mb-6 reveal"
                >
                    Reserva tu <span class="italic">momento.</span>
                </h1>
                <p
                    class="font-body font-light text-glow-bark max-w-2xl mx-auto reveal"
                >
                    Resuelve tus dudas sobre nuestros tratamientos o agenda tu
                    cita. Nos tomaremos el tiempo de responderte con dedicación.
                </p>
            </div>
        </section>

        <!-- Form & Info Section -->
        <section
            class="py-12 md:py-16 bg-glow-mist border-t border-glow-gold/10"
        >
            <div class="container max-w-container mx-auto px-6">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
                    <!-- Contact Form (Left) -->
                    <div class="lg:col-span-7">
                        <div class="reveal">
                            <div
                                class="bg-glow-cream border border-glow-gold/10 rounded-sm p-8 md:p-10 lg:p-12 shadow-sm"
                            >
                                <h2
                                    class="font-heading font-medium text-2xl text-glow-charcoal mb-8"
                                >
                                    Envíanos un mensaje
                                </h2>

                                <form id="contact-form" class="space-y-8">
                                    <div class="relative">
                                        <input
                                            type="text"
                                            id="name"
                                            name="name"
                                            required
                                            placeholder="Tu nombre completo"
                                            class="w-full bg-transparent border-b border-glow-gold/25 py-3.5 text-glow-charcoal placeholder-glow-dusk/50 focus:border-glow-gold focus:outline-none transition-colors duration-300 font-body font-light text-[0.95rem]"
                                        />
                                    </div>

                                    <div class="relative">
                                        <input
                                            type="email"
                                            id="email"
                                            name="email"
                                            required
                                            placeholder="Tu correo electrónico"
                                            class="w-full bg-transparent border-b border-glow-gold/25 py-3.5 text-glow-charcoal placeholder-glow-dusk/50 focus:border-glow-gold focus:outline-none transition-colors duration-300 font-body font-light text-[0.95rem]"
                                        />
                                    </div>

                                    <div class="relative">
                                        <textarea
                                            id="message"
                                            name="message"
                                            required
                                            rows="4"
                                            placeholder="¿En qué podemos ayudarte? Cuéntanos sobre tu tipo de piel o el ritual que te interesa."
                                            class="w-full bg-transparent border-b border-glow-gold/25 py-3.5 text-glow-charcoal placeholder-glow-dusk/50 focus:border-glow-gold focus:outline-none transition-colors duration-300 font-body font-light text-[0.95rem] resize-none"
                                        ></textarea>
                                    </div>

                                    <button
                                        type="submit"
                                        class="btn-glow btn-glow-md w-full justify-center text-center py-4 cursor-pointer mt-4"
                                    >
                                        Enviar Mensaje
                                    </button>
                                </form>

                                <!-- Success Alert (Hidden by default) -->
                                <div
                                    id="form-success"
                                    class="hidden mt-6 p-4 bg-glow-sage/10 border border-glow-sage/35 text-glow-sage text-[0.9rem] rounded-sm font-body font-light text-center reveal"
                                >
                                    ¡Gracias por escribirnos! Procesaremos tu
                                    consulta y te responderemos en las próximas
                                    horas.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Info Details & Map (Right) -->
                    <div class="lg:col-span-5">
                        <div
                            class="reveal flex flex-col justify-between h-full gap-10"
                        >
                            <div class="space-y-8">
                                <div>
                                    <h3
                                        class="font-heading font-medium text-xl text-glow-charcoal mb-4"
                                    >
                                        El Estudio
                                    </h3>
                                    <p
                                        class="font-body font-light text-[0.92rem] leading-relaxed text-glow-bark flex gap-3 items-start"
                                    >
                                        <svg
                                            class="w-5 h-5 text-glow-gold shrink-0 mt-0.5"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="1.5"
                                            ><path
                                                d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                                            ></path><circle
                                                cx="12"
                                                cy="10"
                                                r="3"></circle></svg
                                        >
                                        <span
                                            >Calle Santa Catalina 115, Cercado,
                                            Arequipa — Perú</span
                                        >
                                    </p>
                                </div>

                                <div>
                                    <h3
                                        class="font-heading font-medium text-xl text-glow-charcoal mb-4"
                                    >
                                        Horario de Atención
                                    </h3>
                                    <p
                                        class="font-body font-light text-[0.92rem] leading-relaxed text-glow-bark flex gap-3 items-start"
                                    >
                                        <svg
                                            class="w-5 h-5 text-glow-gold shrink-0 mt-0.5"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="1.5"
                                            ><rect
                                                x="3"
                                                y="4"
                                                width="18"
                                                height="18"
                                                rx="2"
                                                ry="2"></rect><line
                                                x1="16"
                                                y1="2"
                                                x2="16"
                                                y2="6"></line><line
                                                x1="8"
                                                y1="2"
                                                x2="8"
                                                y2="6"></line><line
                                                x1="3"
                                                y1="10"
                                                x2="21"
                                                y2="10"></line></svg
                                        >
                                        <span
                                            >Lunes a Sábado: 9:00 AM — 8:00 PM
                                            (Previa cita)</span
                                        >
                                    </p>
                                </div>

                                <div>
                                    <h3
                                        class="font-heading font-medium text-xl text-glow-charcoal mb-4"
                                    >
                                        Canales de Reserva
                                    </h3>
                                    <div
                                        class="flex flex-col gap-3 font-body font-light text-[0.92rem] text-glow-bark"
                                    >
                                        <a
                                            href="https://wa.me/51999999999"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="hover:text-glow-gold transition-colors flex gap-3 items-center"
                                        >
                                            <svg
                                                class="w-5 h-5 text-glow-gold"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="1.5"
                                                ><path
                                                    d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                                                ></path></svg
                                            >
                                            <span
                                                >+51 999 999 999 (WhatsApp)</span
                                            >
                                        </a>
                                        <a
                                            href="https://instagram.com/glowstudio.aqp"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="hover:text-glow-gold transition-colors flex gap-3 items-center"
                                        >
                                            <svg
                                                class="w-5 h-5 text-glow-gold"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="1.5"
                                                ><rect
                                                    x="2"
                                                    y="2"
                                                    width="20"
                                                    height="20"
                                                    rx="5"
                                                    ry="5"></rect><path
                                                    d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                                                ></path><line
                                                    x1="17.5"
                                                    y1="6.5"
                                                    x2="17.51"
                                                    y2="6.5"></line></svg
                                            >
                                            <span
                                                >@glowstudio.aqp (Instagram)</span
                                            >
                                        </a>
                                        <div class="flex gap-3 items-center">
                                            <svg
                                                class="w-5 h-5 text-glow-gold"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="1.5"
                                                ><path
                                                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                                                ></path><polyline
                                                    points="22,6 12,13 2,6"
                                                ></polyline></svg
                                            >
                                            <span>hola@glowstudio.pe</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Stylized Map Representation -->
                            <div
                                class="relative w-full aspect-[16/9] bg-glow-parchment rounded-sm border border-glow-gold/15 overflow-hidden shadow-inner flex flex-col justify-center items-center text-center p-6 select-none"
                            >
                                <!-- Grid Overlay for Technical Map Aesthetics -->
                                <div
                                    class="absolute inset-0 bg-[linear-gradient(to_right,#A8845A08_1px,transparent_1px),linear-gradient(to_bottom,#A8845A08_1px,transparent_1px)] bg-[size:20px_20px] pointer-events-none"
                                >
                                </div>

                                <!-- Simulated map landmarks -->
                                <div
                                    class="w-2.5 h-2.5 rounded-full bg-glow-gold animate-ping absolute"
                                >
                                </div>
                                <div
                                    class="w-2.5 h-2.5 rounded-full bg-glow-gold absolute"
                                >
                                </div>

                                <div class="relative z-10 mt-8">
                                    <span
                                        class="label text-glow-gold text-[0.65rem] block mb-1"
                                        >Calle Santa Catalina</span
                                    >
                                    <span
                                        class="font-heading font-medium text-glow-charcoal text-base"
                                        >GLOW STUDIO</span
                                    >
                                    <span
                                        class="text-glow-dusk text-[0.7rem] block mt-1"
                                        >A una cuadra de la Plaza de Armas</span
                                    >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<script>
    // Simple form handling simulation
    const form = document.getElementById("contact-form");
    const successAlert = document.getElementById("form-success");

    form?.addEventListener("submit", (e) => {
        e.preventDefault();

        // Simulate API request
        const btn = form.querySelector("button[type='submit']");
        if (btn instanceof HTMLButtonElement) {
            btn.disabled = true;
            btn.innerText = "Enviando...";
        }

        setTimeout(() => {
            // Hide form contents smoothly or reset
            form.reset();
            if (btn instanceof HTMLButtonElement) {
                btn.disabled = false;
                btn.innerText = "Enviar Mensaje";
            }

            // Show success message
            if (successAlert) {
                successAlert.classList.remove("hidden");
                successAlert.classList.add("visible");
            }
        }, 1500);
    });
</script>
